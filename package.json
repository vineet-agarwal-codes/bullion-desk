{
  "name": "bullion-desk",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:server": "npm --workspace=@bullion-desk/server run dev",
    "dev:web": "npm --workspace=@bullion-desk/web run dev",
    "build": "npm --workspace=@bullion-desk/shared run build && npm --workspace=@bullion-desk/server run build && npm --workspace=@bullion-desk/web run build",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:contract": "vitest run --project contract",
    "test:all": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
